<?xml version="1.0" encoding="UTF-8"?>
<!--
  two_page_labels.xml — two shipping labels in a single document, one per page.

  The <break> tag forces a new page between the two labels so each label
  prints cleanly on its own page regardless of label height.

  Render:
    mix atml_pdf.render examples/two_page_labels.xml
-->
<document page-width="400pt" page-height="600pt" font-family="Helvetica" font-size="8pt" padding="12pt">

  <!-- ═══════════════════════════════════════════════════════ LABEL 1 (Page 1) -->

  <!-- Header -->
  <row height="50pt" border="solid 1pt #000000">
    <col width="30%" vertical-align="center" text-align="center" padding="4pt" border-right="solid 1pt #000000">
      <img src="examples/logo.png" width="80pt" height="35pt"/>
    </col>
    <col width="40%" vertical-align="center" text-align="center" padding="4pt"
         font-size="24pt" font-weight="bold" border-right="solid 1pt #000000">
      MAIN
    </col>
    <col width="30%" vertical-align="center" text-align="right" padding="4pt" font-size="7pt">
      LABEL 1 OF 2
    </col>
  </row>

  <!-- Barcode row -->
  <row height="60pt" border-bottom="solid 1pt #000000" border-left="solid 1pt #000000" border-right="solid 1pt #000000">
    <col width="fill" vertical-align="center" text-align="center" padding="8pt 16pt">
      <img src="data:image/png;base64," width="fill" height="40pt"/>
    </col>
  </row>

  <!-- Order / Tracking numbers -->
  <row height="28pt" border-bottom="solid 1pt #000000" border-left="solid 1pt #000000" border-right="solid 1pt #000000">
    <col width="55%" padding="4pt 8pt" vertical-align="center" text-align="center"
         font-size="10pt" border-right="solid 1pt #000000">
      ORD-2024-001001
    </col>
    <col width="45%" padding="4pt 8pt" vertical-align="center" text-align="center" font-size="10pt">
      XDE001001
    </col>
  </row>

  <!-- Recipient -->
  <row border-bottom="solid 1pt #000000" border-left="solid 1pt #000000" border-right="solid 1pt #000000">
    <col width="40pt" vertical-align="center" text-align="center" font-size="7pt"
         border-right="solid 1pt #000000" padding="4pt">
      Buyer
    </col>
    <col width="fill" padding="6pt 8pt">
      <row>
        <col width="fill" font-size="14pt" font-weight="bold">Alice Tan</col>
        <col width="fit" font-size="10pt" font-weight="bold" text-align="right">Express</col>
      </row>
      <row>
        <col font-size="9pt" padding-top="2pt">12 Marina Boulevard, #21-05 MBFC Tower 3</col>
      </row>
      <row>
        <col width="50%" font-size="11pt" font-weight="bold" padding-top="6pt">Marina Bay</col>
        <col width="50%" padding-top="6pt">
          <row><col font-size="11pt" font-weight="bold">Singapore</col></row>
          <row><col font-size="9pt">Singapore 018982</col></row>
        </col>
      </row>
    </col>
  </row>

  <!-- Sender -->
  <row border-bottom="solid 1pt #000000" border-left="solid 1pt #000000" border-right="solid 1pt #000000">
    <col width="40pt" vertical-align="center" text-align="center" font-size="7pt"
         border-right="solid 1pt #000000" padding="4pt">
      Seller
    </col>
    <col width="fill" padding="6pt 8pt">
      <row><col font-size="14pt" font-weight="bold">Tech Gadgets Pte Ltd</col></row>
      <row><col font-size="9pt" padding-top="2pt">3 Fusionopolis Way, #08-21 Symbiosis</col></row>
      <row>
        <col width="50%" font-size="11pt" font-weight="bold" padding-top="6pt">one-north</col>
        <col width="50%" padding-top="6pt">
          <row><col font-size="11pt" font-weight="bold">Singapore</col></row>
          <row><col font-size="9pt">Singapore 138633</col></row>
        </col>
      </row>
    </col>
  </row>

  <!-- Items -->
  <row height="fill" border="solid 1pt #000000">
    <col width="fill" padding="6pt 8pt">
      <row><col font-size="12pt" font-weight="bold">ITEMS:</col></row>
      <row><col font-size="9pt" padding-top="4pt">2x Lotus Towel 100% Cotton Premium Soft Absorbent Bath Towel Set</col></row>
      <row><col font-size="9pt" padding-top="4pt">1x FORNICALMORE Portable Power Bank 20000mAh with Built-in 4-in-1 Charging Cable</col></row>
    </col>
  </row>

  <!-- ══════════════════════════════════════════ PAGE BREAK — start Label 2 -->
  <break />

  <!-- ═══════════════════════════════════════════════════════ LABEL 2 (Page 2) -->

  <!-- Header -->
  <row height="50pt" border="solid 1pt #000000">
    <col width="30%" vertical-align="center" text-align="center" padding="4pt" border-right="solid 1pt #000000">
      <img src="examples/logo.png" width="80pt" height="35pt"/>
    </col>
    <col width="40%" vertical-align="center" text-align="center" padding="4pt"
         font-size="24pt" font-weight="bold" border-right="solid 1pt #000000">
      MAIN
    </col>
    <col width="30%" vertical-align="center" text-align="right" padding="4pt" font-size="7pt">
      LABEL 2 OF 2
    </col>
  </row>

  <!-- Barcode row -->
  <row height="60pt" border-bottom="solid 1pt #000000" border-left="solid 1pt #000000" border-right="solid 1pt #000000">
    <col width="fill" vertical-align="center" text-align="center" padding="8pt 16pt">
      <img src="data:image/png;base64," width="fill" height="40pt"/>
    </col>
  </row>

  <!-- Order / Tracking numbers -->
  <row height="28pt" border-bottom="solid 1pt #000000" border-left="solid 1pt #000000" border-right="solid 1pt #000000">
    <col width="55%" padding="4pt 8pt" vertical-align="center" text-align="center"
         font-size="10pt" border-right="solid 1pt #000000">
      ORD-2024-001002
    </col>
    <col width="45%" padding="4pt 8pt" vertical-align="center" text-align="center" font-size="10pt">
      XDE001002
    </col>
  </row>

  <!-- Recipient -->
  <row border-bottom="solid 1pt #000000" border-left="solid 1pt #000000" border-right="solid 1pt #000000">
    <col width="40pt" vertical-align="center" text-align="center" font-size="7pt"
         border-right="solid 1pt #000000" padding="4pt">
      Buyer
    </col>
    <col width="fill" padding="6pt 8pt">
      <row>
        <col width="fill" font-size="14pt" font-weight="bold">Bob Lim</col>
        <col width="fit" font-size="10pt" font-weight="bold" text-align="right">Standard</col>
      </row>
      <row>
        <col font-size="9pt" padding-top="2pt">88 Orchard Road, #03-12 The Centrepoint</col>
      </row>
      <row>
        <col width="50%" font-size="11pt" font-weight="bold" padding-top="6pt">Orchard</col>
        <col width="50%" padding-top="6pt">
          <row><col font-size="11pt" font-weight="bold">Singapore</col></row>
          <row><col font-size="9pt">Singapore 238858</col></row>
        </col>
      </row>
    </col>
  </row>

  <!-- Sender -->
  <row border-bottom="solid 1pt #000000" border-left="solid 1pt #000000" border-right="solid 1pt #000000">
    <col width="40pt" vertical-align="center" text-align="center" font-size="7pt"
         border-right="solid 1pt #000000" padding="4pt">
      Seller
    </col>
    <col width="fill" padding="6pt 8pt">
      <row><col font-size="14pt" font-weight="bold">Tech Gadgets Pte Ltd</col></row>
      <row><col font-size="9pt" padding-top="2pt">3 Fusionopolis Way, #08-21 Symbiosis</col></row>
      <row>
        <col width="50%" font-size="11pt" font-weight="bold" padding-top="6pt">one-north</col>
        <col width="50%" padding-top="6pt">
          <row><col font-size="11pt" font-weight="bold">Singapore</col></row>
          <row><col font-size="9pt">Singapore 138633</col></row>
        </col>
      </row>
    </col>
  </row>

  <!-- Items -->
  <row height="fill" border="solid 1pt #000000">
    <col width="fill" padding="6pt 8pt">
      <row><col font-size="12pt" font-weight="bold">ITEMS:</col></row>
      <row><col font-size="9pt" padding-top="4pt">3x UGREEN HDMI 2.0 Cable 4K60Hz 18Gbps High Speed Ultra HD</col></row>
      <row><col font-size="9pt" padding-top="4pt">1x Sony WH-1000XM5 Wireless Noise Cancelling Headphones</col></row>
    </col>
  </row>

</document>
